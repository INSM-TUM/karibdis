default1:Immature_Granulocyte a owl:Class ;
    rdfs:label "Immature Granulocyte" ;
    default1:Synonyms "Immature Granulocyte" ;
    default1:definition "A not-yet-mature white blood cell with staining granules in its cytoplasm. The staining granules may be neutrophilic, acidophilic, or basophilic in character. There are indications that an immature granulocyte count is a better measure of infection and sepsis than a total white blood cell count and comparable to absolute neutrophil count." ;
    default1:reference "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13113" ;
    rdfs:subClassOf default1:Adult_Sepsis_Diagnostic_Biomarker .

