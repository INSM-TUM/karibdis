default1:Histone_H3 a owl:Class ;
    rdfs:label "Histone H3" ;
    default1:Synonyms """H3
HISTONE H3
Histone H3""" ;
    default1:definition "Histone H3 is a core subunit of the eukaryotic nucleosome complex. Histones are basic nuclear proteins responsible for the nucleosome structure of chromatin. Repeating nucleosome units contain two molecules each of Histones H2A, H2B, H3, and H4 that form an octamer complex around which approximately 146 base pairs of DNA is wrapped. Linker Histone H1 interacts with DNA between nucleosome units in mediating chromatin compaction into higher order structures. (NCI)" ;
    default1:reference "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C16685" ;
    rdfs:subClassOf default1:Adult_Sepsis_Diagnostic_Biomarker,
        default1:Histone .

default1:Hyaluronan_Synthases a owl:Class ;
    rdfs:label "Hyaluronan Synthases" ;
    default1:Synonyms """Synthase 3, Hyaluronan
Synthetase, Hyaluronic Acid
Synthetase, Hyaluronan
HAS1 Protein
Synthase 2, Hyaluronan
Synthase, Hyaluronate
Hyaluronan Synthase 3
Hyaluronate Synthetase
Synthase 1, Hyaluronan
HAS2 Protein
Protein, HAS3
Hyaluronan Synthase
Hyaluronic Acid Synthetase
HAS3 Protein
3, Hyaluronan Synthase
Hyaluronan Synthetase
Hyaluronan Synthase 2
Synthase, Hyaluronan
Synthetase, Hyaluronate
Hyaluronate Synthase
hasA Enzyme
Synthases, Hyaluronan
Hyaluronan Synthase 1""" ;
    default1:definition "Membrane-associated glucuronosyltransferases that catalyze the reaction of UDP-N-acetyl-D-glucosamine and UDP-D-glucuronate to produce HYALURONAN. HYALURONAN SYNTHASE 2 (HAS2) is essential for embryogenesis and its expression by tumor cells is associated with metastasis." ;
    default1:reference "http://purl.bioontology.org/ontology/MESH/D000076002" ;
    rdfs:subClassOf default1:Adult_Sepsis_Diagnostic_Biomarker .

