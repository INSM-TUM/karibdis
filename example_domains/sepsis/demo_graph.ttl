rules:ExtendStaleCasesRule a sh:NodeShape ;
    sh:condition rules:ExtendStaleCasesRule ;
    sh:rule [ a sh:SPARQLRule ;
            sh:construct """\r
			CONSTRUCT {\r
				?next :partOf $this .\r
				?next rdf:type :Task .\r
			} WHERE {\r
                FILTER NOT EXISTS {\r
                    ?task :partOf $this .\r
                    FILTER NOT EXISTS { ?task :completedAt ?any }\r
                }\r
                FILTER NOT EXISTS {\r
                    $this :isClosed true\r
                }\r
				BIND (rules:nexttask($this) AS ?next) .\r
			}\r
        """ ] ;
    sh:targetClass :Case .

