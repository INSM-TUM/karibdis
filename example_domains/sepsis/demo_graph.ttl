default1:Dendritic_Cells_Count a owl:Class ;
    rdfs:label "Dendritic Cells Count" ;
    default1:Synonyms """Dendritic Cells
Dendritic Cells Count
DC""" ;
    default1:definition "The determination of the amount of dendritic cells present in a sample." ;
    default1:reference "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C181185" ;
    rdfs:subClassOf default1:Adult_Sepsis_Diagnostic_Biomarker,
