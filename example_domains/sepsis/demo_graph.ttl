    rdfs:comment "This term is intended solely for classification purposes and should not be used for direct data annotation." ;
    rdfs:subClassOf obo:MONDO_0700096 .

obo:MONDO_7770008 a owl:Class ;
    rdfs:label "disease by etiologic mechanism" ;
    obo:IAO_0000115 "A grouping class for human diseases classified by their etiologic mechanism, encompassing primarily intrinsic (genetic, genomic), primarily extrinsic (e.g., infections, toxins, radiation), and complex multifactorial (e.g. nutritional) causes." ;
    oboInOwl:id "MONDO:7770008" ;
    rdfs:comment "This term is intended solely for classification purposes and should not be used for direct data annotation." ;
    rdfs:subClassOf obo:MONDO_0700096 .

obo:MONDO_7770010 a owl:Class ;
