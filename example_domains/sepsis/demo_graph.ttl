default1:Systemic_Immune-inflammation_Index a owl:Class ;
    rdfs:label "Systemic Immune-inflammation Index" ;
    default1:Synonyms """Systemic Immune-inflammation Index
SII""" ;
    default1:definition "SII is an inflammation-related indicator that integrates neutrophil, platelet, and lymphocyte counts and can reflect the comprehensive immune and inflammation situation in the body.[url:https://pubmed.ncbi.nlm.nih.gov/31849367/] The SII was defined as follows: SII = P × N/L, where P, N, and L were the preoperative peripheral platelet, neutrophil, and lymphocyte counts, respectively. [url:https://pubmed.ncbi.nlm.nih.gov/25271081/]" ;
    default1:reference "http://www.semanticweb.org/admin/ontologies/2022/7/MIO:02388" ;
    rdfs:subClassOf default1:Adult_Sepsis_Prognostic_Biomarker,
        default1:Clinical_Assessment_Indicator,
        default1:Neonatal_Sepsis_Biomarker .

