default1:Diiodotyrosine a owl:Class ;
    rdfs:label "Diiodotyrosine" ;
    default1:Synonyms """Iodogorgoic Acid
Tyrosine, 3,5-diiodo-
Acid, Iodogorgoic""" ;
    default1:definition "A product from the iodination of MONOIODOTYROSINE. In the biosynthesis of thyroid hormones, diiodotyrosine residues are coupled with other monoiodotyrosine or diiodotyrosine residues to form T4 or T3 thyroid hormones (THYROXINE and TRIIODOTHYRONINE)." ;
    default1:reference "http://purl.bioontology.org/ontology/MESH/D004105" ;
    rdfs:subClassOf default1:Adult_Sepsis_Diagnostic_Biomarker .

default1:Endotoxin a owl:Class ;
    rdfs:label "Endotoxin" ;
    default1:Synonyms """Bacterial Pyrogen
Endotoxin
Endotoxins""" ;
    default1:definition "The lipopolysaccharide complexes that are part of the outer membrane of the cell wall of Gram-negative bacteria such as E. coli, Salmonella, Shigella, Pseudomonas, Neisseria, Haemophilus, and other leading pathogens. Upon bacterial infections, the lipid component (Lipid A) of endotoxin contributes to its toxicity, while the polysaccharide components contribute to immunogenicity." ;
    default1:reference "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C50918" ;
    rdfs:subClassOf default1:Paediatric_Sepsis_Diagnostic_Biomarker .

default1:Eosinophil_Count a owl:Class ;
    rdfs:label "Eosinophil Count" ;
    default1:Synonyms """Eosinophil Count
Eosinophils
EOS
Eosinophil""" ;
    default1:definition "The determination of the number of eosinophils in a blood sample." ;
    default1:reference "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C64550" ;
    rdfs:subClassOf log:ProcessValue_Leucocytes,
        default1:Adult_Sepsis_Prognostic_Biomarker .

default1:Epinephrine a owl:Class ;
    rdfs:label "Epinephrine" ;
    default1:Synonyms """Adrenaline Hydrochloride
Epifrin
Epinephrine Bitartrate
1,2-Benzenediol, 4-(1-hydroxy-2-(methylamino)ethyl)-, (R)-
Epinephrine Hydrochloride
Lyophrin
Adrenaline
Adrenaline Bitartrate
Acetate, Epinephrine
Epinephrine Acetate
4-(1-Hydroxy-2-(methylamino)ethyl)-1,2-benzenediol
Epinephrine Hydrogen Tartrate
Epitrate
Adrenaline Acid Tartrate
Medihaler-Epi""" ;
    default1:definition "The active sympathomimetic hormone from the ADRENAL MEDULLA. It stimulates both the alpha- and beta- adrenergic systems, causes systemic VASOCONSTRICTION and gastrointestinal relaxation, stimulates the HEART, and dilates BRONCHI and cerebral vessels. It is used in ASTHMA and CARDIAC FAILURE and to delay absorption of local ANESTHETICS." ;
    default1:reference "http://purl.bioontology.org/ontology/MESH/D004837" ;
    rdfs:subClassOf default1:Adult_Sepsis_Diagnostic_Biomarker .

default1:Erythrocyte_Distribution_Width_Measurement a owl:Class ;
    rdfs:label "Erythrocyte Distribution Width Measurement" ;
    default1:Synonyms """Erythrocyte Distribution Width Measurement
Erythrocytes Distribution Width
Red Blood Cell Distribution Width
Red Cell Volume Distribution Width
RDW
RDW-CV""" ;
    default1:definition "An index of the variation in the size of the red cells and can be used to detect subtle degress of anisocytosis. It is computed directly from the RBC histogram and is calculated as a standard statictical value, the coefficient of variation of the red cell volume ditribution (ratio of standard deviation and mean copuscular volume)." ;
    default1:reference "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C64800" ;
    rdfs:subClassOf default1:Adult_Sepsis_Prognostic_Biomarker,
        default1:Hematology_Test,
        default1:Neonatal_Sepsis_Biomarker .

default1:F2-Isoprostanes a owl:Class ;
    rdfs:label "F2-Isoprostanes" ;
    default1:Synonyms """F2 Isoprostane
F2 Isoprostanes
F2-Isoprostane""" ;
    default1:definition "Isoprostanes derived from the free radical oxidation of ARACHIDONIC ACID. Although similar in structure to enzymatically synthesized prostaglandin F2alpha (DINOPROST), they occur through non-enzymatic oxidation of cell membrane lipids." ;
    default1:reference "http://purl.bioontology.org/ontology/MESH/D028441" ;
    rdfs:subClassOf default1:Adult_Sepsis_Diagnostic_Biomarker .

default1:Fight_Action_to_Neutralize_Sepsis_Score a owl:Class ;
    rdfs:label "Fight Action to Neutralize Sepsis Score" ;
    default1:Synonyms """Fight Action to Neutralize Sepsis Score
FANS
FANS Score""" ;
    default1:reference "Ognibene A, Lorubbio M, Montemerani S, Tacconi D, Saracini A, Fabbroni S, Parisio EM, Zanobetti M, Mandò M, D'Urso A. Monocyte distribution width and the fighting action to neutralize sepsis (FANS) score for sepsis prediction in emergency department. Clin Chim Acta. 2022 Sep 1;534:65-70. doi: 10.1016/j.cca.2022.07.007. Epub 2022 Jul 16. PMID: 35853545." ;
    rdfs:subClassOf default1:Adult_Sepsis_Diagnostic_Biomarker .

