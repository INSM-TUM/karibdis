default1:Mannose-Binding_Lectin a owl:Class ;
    rdfs:label "Mannose-Binding Lectin" ;
    default1:Synonyms """Lectin, Mannose-Binding
Mannose Binding Protein
Lectin, Mannan-Binding
Mannose-Binding Protein
Mannan Binding Lectin
Mannan Binding Protein
Mannose Binding Lectin
Mannan-Binding Protein
Mannan-Binding Lectin
MBL""" ;
    default1:definition "A specific mannose-binding member of the collectin family of lectins. It binds to carbohydrate groups on invading pathogens and plays a key role in the MANNOSE-BINDING LECTIN COMPLEMENT PATHWAY." ;
    default1:reference "http://purl.bioontology.org/ontology/MESH/D037601" ;
