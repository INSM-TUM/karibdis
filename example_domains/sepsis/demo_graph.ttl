default1:Maximum_Aggregation_Rate a owl:Class ;
    rdfs:label "Maximum Aggregation Rate" ;
    default1:Synonyms """Maximum Aggregation Rate
MAR""" ;
    default1:definition "The maximum platelet aggregation rate refers to the aggregation ability of platelets in the bloodstream, and is an indicator in platelet aggregation function testing. This value is usually divided by the maximum number of platelets divided by the diameter of platelets." ;
    rdfs:subClassOf default1:Adult_Sepsis_Diagnostic_Biomarker .

