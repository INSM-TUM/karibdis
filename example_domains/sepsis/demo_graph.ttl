:AdmitSepsisPatientsRule a sh:PropertyShape ;
    sh:path :instanceOf__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Patients diagnosed with sepsis should be admitted to the hospital." ;
            sh:select """\r
            SELECT  $this (5 AS ?value)\r
            WHERE {\r
                $this :instanceOf__hypothetical ?activity .\r
                FILTER(?activity IN (log:Activity_Admission%20IC, log:Activity_Admission%20NC)) .\r
                $this :partOf / :ProcessValue_Disease <http://purl.obolibrary.org/obo/MONDO_1040015> . # Sepsis\r
            }\r
        """ ] ;
    sh:targetClass :Task .

:CloseReleasedPatientCasesRule a sh:NodeShape ;
    sh:rule [ a sh:SPARQLRule ;
            sh:construct """\r
            CONSTRUCT {\r
                ?this :isClosed True . \r
            } WHERE {\r
                ?task :partOf? ?this.\r
                ?task :instanceOf ?activity.\r
                ?activity rdfs:label ?label .\r
                FILTER regex(?label, "^Release", "i") .\r
                ?task :completedAt ?time .\r
            }\r
        """ ] ;
    sh:targetClass :Case .

:DiagnoseLeukocyteDisorderRule a sh:NodeShape ;
    sh:rule [ a sh:SPARQLRule ;
            sh:construct """\r
            CONSTRUCT {\r
                ?this :ProcessValue_Disease <http://purl.obolibrary.org/obo/MONDO_0004805>. # Leukocyte disorder \r
            } WHERE {\r
                ?task_or_this :partOf? ?this.\r
                ?task_or_this :abnormalValueFor log:ProcessValue_Leucocytes. \r
            }\r
        """ ] ;
    sh:targetClass :Case .

:DiagnoseSepsisOnSIRSRule a sh:NodeShape ;
    sh:rule [ a sh:SPARQLRule ;
            sh:construct """\r
            CONSTRUCT {\r
                ?this :ProcessValue_Disease <http://purl.obolibrary.org/obo/MONDO_1040015>. # Sepsis \r
            } WHERE {\r
                ?this log:ProcessValue_SIRSCriteria2OrMore true . \r
            }\r
        """ ] ;
    sh:targetClass :Case .

:DontReleaseSepsisPatientsRule a sh:PropertyShape ;
    sh:path :instanceOf__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Patients diagnosed with sepsis should not be released without prior admittance to the hospital." ;
            sh:select """\r
            SELECT  $this (-3 AS ?value)\r
            WHERE {\r
                $this :instanceOf__hypothetical ?activity .\r
                ?activity rdfs:label ?label .\r
                FILTER regex(?label, "^Release", "i") .\r
                $this :partOf / :ProcessValue_Disease <http://purl.obolibrary.org/obo/MONDO_1040015> . # Sepsis\r
                FILTER NOT EXISTS {\r
                    $this :partOf / ^:partOf / :instanceOf ?otheractivity .\r
                    FILTER(?otheractivity IN (log:Activity_Admission%20IC, log:Activity_Admission%20NC)) .\r
                }\r
            }\r
        """ ] ;
    sh:targetClass :Task .

:MeasurementOutOfBounds a sh:NodeShape ;
    sh:rule [ a sh:SPARQLRule ;
            sh:construct """\r
            CONSTRUCT {\r
                $this :abnormalValueFor ?processValue .\r
            } WHERE { \r
                $this ?processValue ?value .\r
                ?processValue :normal_min ?min .\r
                ?processValue :normal_max ?max .\r
                FILTER ( ?value < ?min || ?value > ?max )\r
            }\r
        """ ] ;
    sh:targetClass :Case,
        :Task .

:PerformPreventiveTreatment a sh:PropertyShape ;
    sh:path :instanceOf__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "There is an increased risk of '{?disease}' because of '{?reasons}', which require(s) preventive action." ;
            sh:select """\r
            SELECT $this ?disease (STR(GROUP_CONCAT(?reason; separator="' and '")) AS ?reasons) (10 * COUNT(?reason) AS ?value)\r
            WHERE {\r
                $this :instanceOf__hypothetical ?activity .\r
                ?disease :requiresAsPreventiveTreatment ?activity . \r
                $this :partOf ?case .\r
                ?case :ProcessValue_Disease  ?reason .\r
                ?reason :inducesHighRisk ?disease .\r
                FILTER NOT EXISTS {\r
                    ?previous :partOf ?case .\r
                    ?previous :instanceOf ?activity\r
                }\r
            }\r
            GROUP BY $this ?disease\r
        """ ] ;
    sh:targetClass :Task .

:ProcessValue_Disease a :ProcessValue ;
    rdfs:label "Diagnosed Disease" ;
    :dataType obo:MONDO_0700096 .

:ReleaseNonSIRS a sh:PropertyShape ;
    sh:path :instanceOf__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Patients with less than two SIRS criteria should be discharged." ;
            sh:select """\r
            SELECT  $this (2 AS ?value)\r
            WHERE {\r
                $this :instanceOf__hypothetical :ReleaseWithoutAdmission .\r
                $this :partOf / log:ProcessValue_SIRSCriteria2OrMore false . \r
            }\r
        """ ] ;
    sh:targetClass :Task .

:ReleaseWithoutAdmission a :Activity ;
    rdfs:label "Release without Admission" .

:SIRSCriteria2OrMoreRule a sh:NodeShape ;
    sh:rule [ a sh:SPARQLRule ;
            sh:construct """\r
            CONSTRUCT {\r
                ?this log:ProcessValue_SIRSCriteria2OrMore ?two_or_more.\r
            } WHERE {\r
                ?this log:ProcessValue_SIRSCritLeucos ?leucos .\r
                ?this log:ProcessValue_SIRSCritTachypnea ?tachypnea .\r
                ?this log:ProcessValue_SIRSCritHeartRate ?heartrate .\r
                ?this log:ProcessValue_SIRSCritTemperature ?temperature .\r
                BIND(IF(?leucos = true, 1, 0) + IF(?tachypnea = true, 1, 0) + IF(?heartrate = true, 1, 0) + IF(?temperature = true, 1, 0) AS ?sirs_count) .\r
                BIND(?sirs_count >= 2 AS ?two_or_more)\r
            }\r
        """ ] ;
    sh:targetClass :Case .

:SetCaseNameRule a sh:NodeShape ;
    sh:rule [ a sh:SPARQLRule ;
            sh:construct """\r
            CONSTRUCT {\r
                ?this rdfs:label ?caselabel .\r
            } WHERE {\r
                ?this :ProcessValue_Name ?name .\r
                FILTER NOT EXISTS { ?this rdfs:label ?existingLabel. } .\r
                BIND(CONCAT("Patient ", STR( ?name )) AS ?caselabel ) .\r
            }\r
        """ ] ;
    sh:targetClass :Case .

:abnormalValueFor a owl:ObjectProperty ;
    rdfs:label "has abnormal value for" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Task :Case ) ] ;
    rdfs:range :ProcessValue .

:activatedAt a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "The timestamp at which a task became available to be executed" ;
    rdfs:domain :Task ;
    rdfs:range xsd:dateTime .

:canBeExecutedBy a owl:ObjectProperty ;
    rdfs:comment "The specific roles and/or resources that are exclusively allowed to perform an activity" ;
    rdfs:domain :Activity ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( :Resource :Role ) ] .

:completedAt a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "The timestamp at which a task's execution was completed" ;
    rdfs:domain :Task ;
    rdfs:range xsd:dateTime .

:dataType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "The data type of the process value, e.g. 'xsd:string' or 'xsd:integer'." ;
    rdfs:domain :ProcessValue .

:directlyFollowedBy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :Task ;
    rdfs:range :Task .

:hasRole a owl:ObjectProperty ;
    rdfs:comment "A role that the resource has" ;
    rdfs:domain :Resource ;
    rdfs:range :Role .

:inducesHighRisk a owl:ObjectProperty ;
    rdfs:label "induces high risk for" ;
    rdfs:domain obo:MONDO_0700096 ;
    rdfs:range obo:MONDO_0700096 .

:instanceOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "The concrete task is an instance of a recurring activity." ;
    rdfs:domain :Task ;
    rdfs:range :Activity .

:isAvailable a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Whether the resource is currently available to work on a task" ;
    rdfs:domain :Resource ;
    rdfs:range xsd:boolean .

:isClosed a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Whether the case is closed, i.e., not more events are expected to happen" ;
    rdfs:domain :Case ;
    rdfs:range xsd:boolean .

:normal_max a owl:DatatypeProperty ;
    rdfs:label "Maximum of normal value range" ;
    rdfs:domain :ProcessValue ;
    rdfs:range xsd:float .

:normal_min a owl:DatatypeProperty ;
    rdfs:label "Minimum of normal value range" ;
    rdfs:domain :ProcessValue ;
    rdfs:range xsd:float .

:partOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "The case a task belongs to" ;
    rdfs:domain :Task ;
    rdfs:range :Case .

:performedBy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "The resource that has performed or is currently performing the task" ;
    rdfs:domain :Task ;
    rdfs:range :Resource .

:plannedAt a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "The timestamp at which a task was assigned a fixed time or resources to be executed" ;
    rdfs:domain :Task ;
    rdfs:range xsd:dateTime .

:requiresAsPreventiveTreatment a owl:ObjectProperty ;
    rdfs:label "requires as preventive treatment" ;
    rdfs:domain obo:MONDO_0700096 ;
    rdfs:range :Activity .

:startedAt a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "The timestamp at which a task's execution was started" ;
    rdfs:domain :Task ;
    rdfs:range xsd:dateTime .

:writesValue a owl:ObjectProperty ;
    rdfs:comment "One process value that is written by the activity." ;
    rdfs:domain :Activity ;
    rdfs:range :ProcessValue .

declare:AtLeastOnce a sh:PropertyShape ;
    sh:path :instanceOf__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Activity '{?activity}' should still be executed." ;
            sh:select """\r
            SELECT $this ?activity (IF(STR(?activity) = STR(?thisactivity), 0.2,-0.1) as ?value)\r
            WHERE { \r
                $this :partOf ?case .\r
                $this :instanceOf__hypothetical ?thisactivity .\r
                ?activity declare:exactly_one ?activity .\r
                FILTER NOT EXISTS {\r
                    ?othertask :instanceOf ?activity .\r
                    ?othertask :partOf ?case .\r
                }\r
                \r
            }\r
        """ ] ;
    sh:targetClass :Task .

declare:AtMostOnce a sh:PropertyShape ;
    sh:path :instanceOf__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Activity '{?activity}' should be executed only once." ;
            sh:select """\r
            SELECT $this ?activity (-1 AS ?value)\r
            WHERE { \r
                $this :instanceOf__hypothetical ?activity .\r
                $this :partOf ?case .\r
                ?activity declare:exactly_one ?activity . \r
                {\r
                    SELECT (COUNT(distinct ?othertask) as ?count)\r
                    WHERE {\r
                        ?othertask :partOf ?case .\r
                        ?othertask :instanceOf | :instanceOf__hypothetical ?activity .\r
                    }\r
                }\r
                FILTER(?count > 1)\r
            }\r
        """ ] ;
    sh:targetClass :Task .

declare:ChainResponseRule a sh:NodeShape ;
    sh:rule [ a sh:SPARQLRule ;
            sh:construct """\r
            PREFIX declare: <http://infs.cit.tum.de/karibdis/declare/>\r
			CONSTRUCT {\r
				?tail :instanceOf ?b .\r
			} WHERE { \r
                ?tail :partOf $this .\r
                 FILTER NOT EXISTS {\r
                    ?tail :instanceOf ?any.\r
                }\r
				BIND (rules:lastCompleted($this) AS ?last) .\r
                ?last2 :instanceOf ?a.\r
                ?a declare:chainresponse ?b.\r
                FILTER(?last = ?last2)\r
            }\r
        """ ] ;
    sh:targetClass :Case .

declare:ChoiceRule a sh:PropertyShape ;
    sh:path :instanceOf__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "At least one of '{?a}' or '{?b}' must occur." ;
            sh:select """\r
            PREFIX declare: <http://infs.cit.tum.de/karibdis/declare/>\r
            SELECT $this ?a ?b (0.25 AS ?value)\r
            WHERE {\r
                \r
                $this :partOf ?case .\r
                $this :instanceOf__hypothetical ?thisactivity .\r
                ?a declare:choice ?b .\r
                FILTER(?thisactivity = ?a || ?thisactivity = ?b) .\r
                FILTER NOT EXISTS { ?t1 :partOf ?case ; :instanceOf ?a . }\r
                FILTER NOT EXISTS { ?t2 :partOf ?case ; :instanceOf ?b . }\r
            }\r
        """ ] ;
    sh:targetClass :Task .

declare:InitRule a sh:NodeShape ;
    sh:rule [ a sh:SPARQLRule ;
            sh:construct """\r
            PREFIX declare: <http://infs.cit.tum.de/karibdis/declare/>\r
			CONSTRUCT {\r
				?tail :instanceOf ?init .\r
			} WHERE { \r
                ?init declare:init ?init . # TODO: check that it's the only one - and make it process specific ...\r
                ?tail :partOf $this .\r
                FILTER NOT EXISTS {\r
                    ?tail :instanceOf ?any.\r
                }\r
                FILTER NOT EXISTS {\r
                    ?other :partOf $this .\r
                    FILTER(?other != ?tail)\r
                }\r
            }\r
        """ ;
            sh:prefixes : ] ;
    sh:targetClass :Case .

declare:NotRespondedExistenceRule a sh:PropertyShape ;
    sh:path :instanceOf__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Activity '{?b}' must not be performed because '{?a}' has been performed." ;
            sh:select """\r
            PREFIX declare: <http://infs.cit.tum.de/karibdis/declare/>\r
            SELECT $this ?a ?b (-1.0 AS ?value)\r
            WHERE {\r
                $this :partOf ?case .\r
                $this :instanceOf__hypothetical ?b .\r
                ?a (declare:not_responded_existence | ^declare:not_responded_existence) ?b . \r
                FILTER EXISTS {\r
                    ?atask :partOf ?case ;\r
                           :instanceOf ?a .\r
                }\r
            }\r
        """ ] ;
    sh:targetClass :Task .

declare:PrecedenceRule a sh:PropertyShape ;
    sh:path :instanceOf__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Activity '{?b}' must not be performed as '{?a}' has not been performed yet." ;
            sh:select """\r
            PREFIX declare: <http://infs.cit.tum.de/karibdis/declare/>\r
            SELECT $this ?a ?b (-0.5 AS ?value)\r
            WHERE {\r
                $this :partOf ?case .\r
                $this :instanceOf__hypothetical ?thisactivity .\r
                ?a declare:precedence ?b .\r
                FILTER NOT EXISTS {\r
                    ?atask :partOf ?case ;\r
                           :instanceOf ?a ;\r
                           :completedAt ?atime .\r
                    \r
                }\r
                FILTER(?thisactivity = ?b)\r
            }\r
        """ ] ;
    sh:targetClass :Task .

declare:RespondedExistenceRule a sh:PropertyShape ;
    sh:path :instanceOf__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Activity '{?b}' must be performed because '{?a}' has been performed." ;
            sh:select """\r
            PREFIX declare: <http://infs.cit.tum.de/karibdis/declare/>\r
            SELECT $this ?a ?b (IF(STR(?thisactivity) = STR(?b), 0.3, -0.05) AS ?value)\r
            WHERE {\r
                $this :partOf ?case .\r
                $this :instanceOf__hypothetical ?thisactivity .\r
                ?atask :partOf ?case .\r
                ?atask :instanceOf ?a .\r
                ?a declare:responded_existence ?b .\r
                FILTER NOT EXISTS {\r
                    ?btask :partOf ?case .\r
                    ?btask :instanceOf ?b .\r
                }\r
            }\r
        """ ] ;
    sh:targetClass :Task .

declare:ResponseRule a sh:PropertyShape ;
    sh:path :instanceOf__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Activity '{?b}' must be performed after '{?a}' ." ;
            sh:select """\r
            PREFIX declare: <http://infs.cit.tum.de/karibdis/declare/>\r
            SELECT $this ?a ?b (IF(STR(?thisactivity) = STR(?b), 0.3, -0.05) AS ?value)\r
            WHERE {\r
                $this :partOf ?case .\r
                $this :instanceOf__hypothetical ?thisactivity .\r
                \r
                ?atask :partOf ?case .\r
                ?atask :instanceOf ?a .\r
                ?atask :completedAt ?atime .\r
                ?a declare:response ?b .\r
                \r
                FILTER NOT EXISTS {\r
                    ?btask :partOf ?case .\r
                    ?btask :instanceOf ?b .\r
                    ?btask :completedAt ?btime .\r
                    FILTER(?btime > ?atime)\r
                }\r
            }\r
        """ ] ;
    sh:targetClass :Task .

declare:chainresponse a owl:ObjectProperty ;
    rdfs:comment "If the subject activity occurs, the object activity must occur next." ;
    rdfs:domain :Activity ;
    rdfs:range :Activity .

declare:choice a owl:ObjectProperty ;
    rdfs:comment "At least one of the subject or object activity must occur." ;
    rdfs:domain :Activity ;
    rdfs:range :Activity .

declare:exactly_one a owl:ObjectProperty ;
    rdfs:comment "This activity must occur exactly once." ;
    rdfs:domain :Activity ;
    rdfs:range :Activity .

declare:init a owl:ObjectProperty ;
    rdfs:comment "The first activity for this process." ;
    rdfs:domain :Activity ;
    rdfs:range :Activity .

declare:not_responded_existence a owl:ObjectProperty ;
    rdfs:comment "If A occurs, B must never occur." ;
    rdfs:domain :Activity ;
    rdfs:range :Activity .

declare:precedence a owl:ObjectProperty ;
    rdfs:comment "B can only occur if A has occurred before." ;
    rdfs:domain :Activity ;
    rdfs:range :Activity .

declare:responded_existence a owl:ObjectProperty ;
    rdfs:comment "If A occurs, B must occur somewhere in the case." ;
    rdfs:domain :Activity ;
    rdfs:range :Activity .

declare:response a owl:ObjectProperty ;
    rdfs:comment "If A occurs, B must occur somewhere after A in the case." ;
    rdfs:domain :Activity ;
    rdfs:range :Activity .

rules:ExecutionPermissionConstraint a sh:PropertyShape ;
    sh:path :performedBy__hypothetical ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The resource '{?resource}' is not allowed to perform the activity '{?activity}'" ;
            sh:select """\r
            SELECT $this ?activity ?resource\r
            WHERE {\r
                $this :performedBy__hypothetical ?resource .\r
                $this :instanceOf ?activity .\r
                FILTER NOT EXISTS { \r
                    ?resource :hasRole* / ^:canBeExecutedBy ?activity .\r
                }\r
            }\r
        """ ] ;
    sh:targetClass :Task .

rules:ExecutionPermissionReward a sh:PropertyShape ;
    sh:path :performedBy__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Resource has relevant role(s) for activity '{?activity}'" ;
            sh:select """\r
            SELECT $this ?activity ?resource (2 AS ?value)\r
            WHERE {\r
                $this :performedBy__hypothetical ?resource .\r
                $this :instanceOf ?activity .\r
                FILTER EXISTS { \r
                    ?resource :hasRole* / ^:canBeExecutedBy ?activity .\r
                }\r
            }\r
        """ ] ;
    sh:targetClass :Task .

rules:lastCompleted a sh:SPARQLFunction ;
    sh:parameter [ sh:datatype :Case ;
            sh:description "The case" ;
            sh:path rules:op1 ] ;
    sh:returnType :Task ;
    sh:select """\r
        SELECT (SAMPLE(?task) as ?result) # Note: SAMPLE is a fix for pySHACL error when returning and binding empty list; might not be compliant to SPARQL standard \r
        WHERE {\r
            ?task :partOf ?op1.\r
            {\r
                SELECT (MAX(?completedAt) AS ?maxCompletedAt) WHERE {\r
                    ?task2 :partOf ?op1 .\r
                    ?task2 :completedAt ?completedAt .\r
                }\r
            }\r
            ?task :completedAt ?maxCompletedAt .\r
        }\r
        LIMIT 1\r
    """ .

rules:nexttask a sh:SPARQLFunction ;
    sh:parameter [ sh:datatype :Case ;
            sh:description "The case" ;
            sh:path rules:op1 ] ;
    sh:returnType :Task ;
    sh:select """\r
        SELECT (URI(CONCAT(STRBEFORE(str(?op1), "Case_"), "Task_", STRAFTER(str(?op1), "Case_"), "_", STR(COUNT(?c) + 1))) AS ?result)\r
        WHERE {\r
            OPTIONAL {?c :partOf ?op1. }\r
        }\r
    """ .

obo:IAO_0000115 a owl:AnnotationProperty ;
    rdfs:label "definition",
        "definition"@en ;
    obo:IAO_0000111 "definition"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000115 "The official definition, explaining the meaning of a class or property. Shall be Aristotelian, formalized and normalized. Can be augmented with colloquial definitions."@en ;
    obo:IAO_0000116 """2012-04-05: 
Barry Smith

The official OBI definition, explaining the meaning of a class or property: 'Shall be Aristotelian, formalized and normalized. Can be augmented with colloquial definitions'  is terrible.

Can you fix to something like:

A statement of necessary and sufficient conditions explaining the meaning of an expression referring to a class or property.

Alan Ruttenberg

Your proposed definition is a reasonable candidate, except that it is very common that necessary and sufficient conditions are not given. Mostly they are necessary, occasionally they are necessary and sufficient or just sufficient. Often they use terms that are not themselves defined and so they effectively can't be evaluated by those criteria. 

On the specifics of the proposed definition:

We don't have definitions of 'meaning' or 'expression' or 'property'. For 'reference' in the intended sense I think we use the term 'denotation'. For 'expression', I think we you mean symbol, or identifier. For 'meaning' it differs for class and property. For class we want documentation that let's the intended reader determine whether an entity is instance of the class, or not. For property we want documentation that let's the intended reader determine, given a pair of potential relata, whether the assertion that the relation holds is true. The 'intended reader' part suggests that we also specify who, we expect, would be able to understand the definition, and also generalizes over human and computer reader to include textual and logical definition. 

Personally, I am more comfortable weakening definition to documentation, with instructions as to what is desirable. 

We also have the outstanding issue of how to aim different definitions to different audiences. A clinical audience reading chebi wants a different sort of definition documentation/definition from a chemistry trained audience, and similarly there is a need for a definition that is adequate for an ontologist to work with.  """@en ;
    obo:IAO_0000117 "PERSON:Daniel Schober"@en ;
    obo:IAO_0000119 "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en .

