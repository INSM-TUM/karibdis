log:Activity_ER%20Registration a :Activity ;
    rdfs:label "ER Registration" ;
    :writesValue log:ProcessValue_Age,
        :ProcessValue_Name ;
    declare:chainresponse log:Activity_ER%20Triage ;
    declare:exactly_one log:Activity_ER%20Registration ;
    declare:init log:Activity_ER%20Registration .

log:Activity_ER%20Sepsis%20Triage a :Activity ;
    rdfs:label "ER Sepsis Triage" ;
    :writesValue log:ProcessValue_SIRSCritHeartRate,
        log:ProcessValue_SIRSCritLeucos,
        log:ProcessValue_SIRSCritTachypnea,
        log:ProcessValue_SIRSCritTemperature ;
    declare:exactly_one log:Activity_ER%20Sepsis%20Triage .

log:Activity_ER%20Triage a :Activity ;
    rdfs:label "ER Triage" ;
    :writesValue log:ProcessValue_InfectionSuspected ;
    declare:chainresponse log:Activity_ER%20Sepsis%20Triage ;
    declare:exactly_one log:Activity_ER%20Triage .

