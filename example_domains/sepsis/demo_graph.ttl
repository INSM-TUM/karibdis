obo:MONDO_7770007 a owl:Class ;
    rdfs:label "disease by developmental or physiological process" ;
    obo:IAO_0000115 "A grouping class for human diseases classified by the molecular, biochemical, cellular, anatomic, developmental or physiological process that is disrupted." ;
