# A subset of (condec)DECLARE formalized in ontology and rules
@prefix : <http://infs.cit.tum.de/karibdis/baseontology/> .
@base <http://infs.cit.tum.de/karibdis/baseontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rules: <http://infs.cit.tum.de/karibdis/rules/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix declare: <http://infs.cit.tum.de/karibdis/declare/> .


declare:init rdf:type owl:ObjectProperty;
    rdfs:domain :Activity ;
    rdfs:range :Activity ;
    rdfs:comment "The first activity for this process.".

declare:InitRule a sh:NodeShape ;
    sh:targetClass :Case ;
	sh:rule [
        a sh:SPARQLRule ;
		sh:prefixes : ;
		sh:construct """
            PREFIX declare: <http://infs.cit.tum.de/karibdis/declare/>
			CONSTRUCT {
				?tail :instanceOf ?init .
			} WHERE { 
                ?init declare:init ?init . # TODO: check that it's the only one - and make it process specific ...
                ?tail :partOf $this .
                FILTER NOT EXISTS {
                    ?tail :instanceOf ?any.
                }
                FILTER NOT EXISTS {
                    ?other :partOf $this .
                    FILTER(?other != ?tail)
                }
            }
        """ ;
	] .

declare:choice rdf:type owl:ObjectProperty ;
    rdfs:domain :Activity ;
    rdfs:range :Activity ;
    rdfs:comment "At least one of the subject or object activity must occur.".

declare:ChoiceRule a sh:PropertyShape ;
    sh:targetClass :Task ;
    sh:path :instanceOf__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "At least one of '{?a}' or '{?b}' must occur." ;
        sh:select """
            PREFIX declare: <http://infs.cit.tum.de/karibdis/declare/>
            SELECT $this ?a ?b (0.25 AS ?value)
            WHERE {
                
                $this :partOf ?case .
                $this :instanceOf__hypothetical ?thisactivity .
                ?a declare:choice ?b .
                FILTER(?thisactivity = ?a || ?thisactivity = ?b) .
                FILTER NOT EXISTS { ?t1 :partOf ?case ; :instanceOf ?a . }
                FILTER NOT EXISTS { ?t2 :partOf ?case ; :instanceOf ?b . }
            }
        """ ;
    ] .

declare:responded_existence rdf:type owl:ObjectProperty ;
    rdfs:domain :Activity ;
    rdfs:range :Activity ;
    rdfs:comment "If A occurs, B must occur somewhere in the case.".

declare:RespondedExistenceRule a sh:PropertyShape ;
    sh:targetClass :Task ;
    sh:path :instanceOf__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Activity '{?b}' must occur somewhere because '{?a}' occurs somewhere." ;
        sh:select """
            PREFIX declare: <http://infs.cit.tum.de/karibdis/declare/>
            SELECT $this ?b (IF(STR(?thisactivity) = STR(?b), 0.3, -0.05) AS ?value)
            WHERE {
                $this :partOf ?case .
                $this :instanceOf__hypothetical ?thisactivity .
                ?atask :partOf ?case .
                ?atask :instanceOf ?a .
                ?a declare:responded_existence ?b .
                FILTER NOT EXISTS {
                    ?btask :partOf ?case .
                    ?btask :instanceOf ?b .
                }
            }
        """ ;
    ] .

declare:response rdf:type owl:ObjectProperty ;
    rdfs:domain :Activity ;
    rdfs:range :Activity ;
    rdfs:comment "If A occurs, B must occur somewhere after A in the case.".

declare:ResponseRule a sh:PropertyShape ;
    sh:targetClass :Task ;
    sh:path :instanceOf__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Activity '{?b}' must occur somewhere after '{?a}' because '{?a}' occurs somewhere." ;
        sh:select """
            PREFIX declare: <http://infs.cit.tum.de/karibdis/declare/>
            SELECT $this ?b (IF(STR(?thisactivity) = STR(?b), 0.3, -0.05) AS ?value)
            WHERE {
                $this :partOf ?case .
                $this :instanceOf__hypothetical ?thisactivity .
                
                ?atask :partOf ?case .
                ?atask :instanceOf ?a .
                ?atask :completedAt ?atime .
                ?a declare:response ?b .
                
                FILTER NOT EXISTS {
                    ?btask :partOf ?case .
                    ?btask :instanceOf ?b .
                    ?btask :completedAt ?btime .
                    FILTER(?btime > ?atime)
                }
            }
        """ ;
    ] .

declare:not_responded_existence rdf:type owl:ObjectProperty ;
    rdfs:domain :Activity ;
    rdfs:range :Activity ;
    rdfs:comment "If A occurs, B must never occur.".

declare:NotRespondedExistenceRule a sh:PropertyShape ;
    sh:targetClass :Task ;
    sh:path :instanceOf__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Activity '{?b}' must not occur because '{?a}' has occurred." ;
        sh:select """
            PREFIX declare: <http://infs.cit.tum.de/karibdis/declare/>
            SELECT $this ?a ?b (-1.0 AS ?value)
            WHERE {
                $this :partOf ?case .
                $this :instanceOf__hypothetical ?b .
                ?a declare:not_responded_existence ?b .
                FILTER EXISTS {
                    ?atask :partOf ?case ;
                           :instanceOf ?a .
                }
            }
        """ ;
    ] .

declare:precedence rdf:type owl:ObjectProperty ;
    rdfs:domain :Activity ;
    rdfs:range :Activity ;
    rdfs:comment "B can only occur if A has occurred before.".

declare:PrecedenceRule a sh:PropertyShape ;
    sh:targetClass :Task ;
    sh:path :instanceOf__hypothetical ;
    sh:severity sh:Info ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Activity '{?b}' can only occur if '{?a}' has occurred before." ;
        sh:select """
            PREFIX declare: <http://infs.cit.tum.de/karibdis/declare/>
            SELECT $this ?a ?b (-0.5 AS ?value)
            WHERE {
                $this :partOf ?case .
                $this :instanceOf__hypothetical ?thisactivity .
                ?a declare:precedence ?b .
                FILTER NOT EXISTS {
                    ?atask :partOf ?case ;
                           :instanceOf ?a ;
                           :completedAt ?atime .
                    
                }
                FILTER(?thisactivity = ?b)
            }
        """ ;
    ] .
    

declare:chainresponse rdf:type owl:ObjectProperty;
    rdfs:domain :Activity ;
    rdfs:range :Activity ;
    rdfs:comment "If the subject activity occurs, the object activity must occur next.".

declare:ChainResponseRule a sh:NodeShape ;
    sh:targetClass :Case ;
	sh:rule [
        a sh:SPARQLRule ;
		sh:construct """
            PREFIX declare: <http://infs.cit.tum.de/karibdis/declare/>
			CONSTRUCT {
				?tail :instanceOf ?b .
			} WHERE { 
                ?tail :partOf $this .
                 FILTER NOT EXISTS {
                    ?tail :instanceOf ?any.
                }
				BIND (rules:lastCompleted($this) AS ?last) .
                ?last2 :instanceOf ?a.
                ?a declare:chainresponse ?b.
                FILTER(?last = ?last2)
            }
        """ ;
	] .


declare:exactly_one rdf:type owl:ObjectProperty;
    rdfs:domain :Activity ;
    rdfs:range :Activity ;
    rdfs:comment "This activity must occur exactly once.".


declare:AtMostOnce a sh:PropertyShape ;
    sh:targetClass :Task ;
    sh:path :instanceOf__hypothetical;
    sh:severity sh:Info;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Activity '{?activity}' should be executed only once." ;
        sh:select """
            SELECT $this ?activity (-1 AS ?value)
            WHERE { 
                $this :instanceOf__hypothetical ?activity .
                $this :partOf ?case .
                ?activity declare:exactly_one ?activity . 
                {
                    SELECT (COUNT(distinct ?othertask) as ?count)
                    WHERE {
                        ?othertask :partOf ?case .
                        ?othertask :instanceOf | :instanceOf__hypothetical ?activity .
                    }
                }
                FILTER(?count > 1)
            }
        """ ;
    ] .

declare:AtLeastOnce a sh:PropertyShape ;
    sh:targetClass :Task ;
    sh:path :instanceOf__hypothetical;
    sh:severity sh:Info;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Activity '{?activity}' should still be executed." ;
        sh:select """
            SELECT $this ?activity (IF(STR(?activity) = STR(?thisactivity), 0.2,-0.1) as ?value)
            WHERE { 
                $this :partOf ?case .
                $this :instanceOf__hypothetical ?thisactivity .
                ?activity declare:exactly_one ?activity .
                FILTER NOT EXISTS {
                    ?othertask :instanceOf ?activity .
                    ?othertask :partOf ?case .
                }
                
            }
        """ ;
    ] .